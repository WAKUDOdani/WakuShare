{
  "name": "wakushare",
  "version": "1.3.2",
  "description": "Free CapCut project backup and transfer, based on CapShare. Maintained by WAKUDO Dani.",
  "main": "./out/main/index.js",
  "author": {
    "name": "WAKUDO Dani",
    "url": "https://t.me/WAKUDOdani"
  },
  "homepage": "https://github.com/WAKUDOdani/WakuShare",
  "packageManager": "pnpm@10.19.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "@tailwindcss/oxide",
      "macos-window-effects"
    ]
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"['out','dist','.eslintcache','.vite'].forEach((p) => require('fs').rmSync(p, { recursive: true, force: true }))\"",
    "clean:all": "pnpm run clean && node -e \"require('fs').rmSync('node_modules', { recursive: true, force: true })\"",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps && node build/ensure-electron.cjs",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run typecheck && node scripts/build-windows.mjs",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux",
    "release": "node scripts/prepare-release.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@heroui/react": "^3.1.0",
    "@heroui/styles": "^3.1.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "ms": "2.1.3",
    "react-icons": "^5.6.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "macos-window-effects": "file:native/macos-window-effects"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^3.3.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "clsx": "^2.1.1",
    "electron": "^42.3.3",
    "electron-builder": "26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-aria-components": "1.18.0",
    "react-dom": "^19.2.1",
    "resedit": "1.7.2",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.6"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WAKUDOdani/WakuShare.git"
  },
  "bugs": {
    "url": "https://github.com/WAKUDOdani/WakuShare/issues"
  }
}
